# PostgreSQL settings for local development
# Copy to .env and fill values before running services
POSTGRES_USER=pset2
POSTGRES_PASSWORD=pset2password
POSTGRES_DB=pset2_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API & UI
# Where the frontend should call the API from the browser. Keep as http://api:8000 for compose.
API_BASE_URL=http://api:8000
