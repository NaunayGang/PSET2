@startuml use-case-diagram

left to right direction
skinparam packageStyle rectangle

title Diagrama de Casos de Uso - Sistema Bancario MVP

:Cliente: as Cliente

rectangle "Sistema Bancario" {
    
    ' Casos de uso principales
    usecase "Crear Cliente" as UC1
    usecase "Crear Cuenta" as UC2
    usecase "Depositar" as UC3
    usecase "Retirar" as UC4
    usecase "Transferir" as UC5
    usecase "Consultar Saldo" as UC6
    usecase "Listar Transacciones" as UC7
    
    ' Casos de uso internos (validaciones)
    usecase "Calcular Comisión" as UC_Fee
    usecase "Validar Reglas\nde Riesgo" as UC_Risk
    usecase "Validar Fondos\nSuficientes" as UC_Funds
    usecase "Registrar en\nLedger" as UC_Ledger
}

' Relaciones Actor -> Casos de Uso
Cliente --> UC1 : registra sus datos
Cliente --> UC2 : solicita apertura
Cliente --> UC3 : deposita fondos
Cliente --> UC4 : retira efectivo
Cliente --> UC5 : transfiere dinero
Cliente --> UC6 : consulta balance
Cliente --> UC7 : revisa historial

' Relaciones Include
UC3 .> UC_Fee : <<include>>
UC3 .> UC_Risk : <<include>>
UC3 .> UC_Ledger : <<include>>

UC4 .> UC_Fee : <<include>>
UC4 .> UC_Risk : <<include>>
UC4 .> UC_Funds : <<include>>
UC4 .> UC_Ledger : <<include>>

UC5 .> UC_Fee : <<include>>
UC5 .> UC_Risk : <<include>>
UC5 .> UC_Funds : <<include>>
UC5 .> UC_Ledger : <<include>>

' Relaciones Extend
UC2 ..> UC1 : <<extend>>\nsi cliente no existe

note right of UC_Fee
  <b>Estrategias de comisión:</b>
  - Sin comisión (0%)
  - Comisión fija ($0.50)
  - Comisión porcentual (1.5%)
  - Comisión escalonada
end note

note right of UC_Risk
  <b>Reglas de riesgo/fraude:</b>
  - Monto máximo por transacción
  - Velocidad (5 txns en 10 min)
  - Límite diario ($50,000)
end note

note bottom of UC_Ledger
  <b>Contabilidad de doble entrada:</b>
  Cada transacción genera asientos
  DEBIT y CREDIT en el ledger
  para auditabilidad completa.
end note

@enduml
