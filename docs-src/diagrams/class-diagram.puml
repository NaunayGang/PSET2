@startuml class-diagram
!define LIGHTBLUE #E3F2FD
!define BLUE #2196F3
!define GREEN #4CAF50
!define ORANGE #FF9800
!define PURPLE #9C27B0

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor LIGHTBLUE
    BorderColor BLUE
    ArrowColor BLUE
}

title Diagrama de Clases - Sistema Bancario (Dominio + Patrones)

' ==================== DOMAIN MODELS ====================

package "Domain Models" <<Rectangle>> {
    
    class Customer {
        - id: UUID
        - name: str
        - email: str
        - status: str
        - created_at: datetime
        + __init__(name, email)
        + __repr__(): str
    }
    
    class Account {
        - id: UUID
        - customer_id: UUID
        - currency: Currency
        - _balance: Decimal
        - status: AccountStatus
        - created_at: datetime
        + balance: Decimal
        + can_operate(): bool
        + credit(amount: Decimal): void
        + debit(amount: Decimal): void
        + freeze(): void
        + unfreeze(): void
        + close(): void
    }
    
    class Transaction {
        - id: UUID
        - type: TransactionType
        - amount: Decimal
        - currency: Currency
        - from_account_id: UUID | None
        - to_account_id: UUID | None
        - status: TransactionStatus
        - fee: Decimal
        - description: str | None
        - rejection_reason: str | None
        - created_at: datetime
        + approve(): void
        + reject(reason: str): void
    }
    
    class LedgerEntry {
        - id: UUID
        - account_id: UUID
        - transaction_id: UUID
        - direction: LedgerDirection
        - amount: Decimal
        - description: str | None
        - created_at: datetime
    }
    
    enum AccountStatus {
        ACTIVE
        FROZEN
        CLOSED
    }
    
    enum TransactionType {
        DEPOSIT
        WITHDRAW
        TRANSFER
    }
    
    enum TransactionStatus {
        PENDING
        APPROVED
        REJECTED
    }
    
    enum LedgerDirection {
        DEBIT
        CREDIT
    }
    
    enum Currency {
        USD
    }
    
    class Money <<ValueObject>> {
        - _amount: Decimal
        - _currency: Currency
        + amount: Decimal
        + currency: Currency
        + __add__(other: Money): Money
        + __sub__(other: Money): Money
    }
}

' ==================== DOMAIN EXCEPTIONS ====================

package "Domain Exceptions" <<Rectangle>> {
    class DomainException extends Exception
    class InsufficientFundsError extends DomainException
    class AccountFrozenError extends DomainException
    class AccountClosedError extends DomainException
    class InvalidTransactionError extends DomainException
    class CustomerNotFoundError extends DomainException
    class AccountNotFoundError extends DomainException
}

' ==================== STRATEGY PATTERN - FEE ====================

package "Fee Strategies (Strategy Pattern)" <<Rectangle>> #GREEN {
    
    abstract class FeeStrategy <<interface>> {
        + {abstract} calculate_fee(amount: Decimal): Decimal
        + {abstract} get_name(): str
    }
    
    class NoFeeStrategy {
        + calculate_fee(amount: Decimal): Decimal
        + get_name(): str
    }
    
    class FlatFeeStrategy {
        - _flat_amount: Decimal
        + calculate_fee(amount: Decimal): Decimal
        + get_name(): str
    }
    
    class PercentFeeStrategy {
        - _percent: Decimal
        + calculate_fee(amount: Decimal): Decimal
        + get_name(): str
    }
    
    class TieredFeeStrategy {
        - _threshold: Decimal
        - _low_tier_fee: Decimal
        - _high_tier_percent: Decimal
        + calculate_fee(amount: Decimal): Decimal
        + get_name(): str
    }
    
    FeeStrategy <|.. NoFeeStrategy
    FeeStrategy <|.. FlatFeeStrategy
    FeeStrategy <|.. PercentFeeStrategy
    FeeStrategy <|.. TieredFeeStrategy
}

' ==================== STRATEGY PATTERN - RISK ====================

package "Risk Strategies (Strategy Pattern)" <<Rectangle>> #ORANGE {
    
    class RiskCheckResult {
        + passed: bool
        + reason: str | None
    }
    
    abstract class RiskStrategy <<interface>> {
        + {abstract} check(amount, account_id, type, get_recent_txns): RiskCheckResult
        + {abstract} get_name(): str
    }
    
    class MaxAmountRule {
        - _max_amount: Decimal
        + check(...): RiskCheckResult
        + get_name(): str
    }
    
    class VelocityRule {
        - _max_transactions: int
        - _time_window_minutes: int
        + check(...): RiskCheckResult
        + get_name(): str
    }
    
    class DailyLimitRule {
        - _daily_limit: Decimal
        + check(...): RiskCheckResult
        + get_name(): str
    }
    
    RiskStrategy <|.. MaxAmountRule
    RiskStrategy <|.. VelocityRule
    RiskStrategy <|.. DailyLimitRule
    RiskStrategy ..> RiskCheckResult : returns
}

' ==================== FACTORY PATTERN ====================

package "Creational Patterns" <<Rectangle>> #PURPLE {
    
    class TransactionFactory <<Factory Method>> {
        + {static} create_deposit(...): Transaction
        + {static} create_withdraw(...): Transaction
        + {static} create_transfer(...): Transaction
    }
    
    class TransactionBuilder <<Builder>> {
        - _type: TransactionType | None
        - _amount: Decimal | None
        - _currency: Currency
        - _from_account_id: UUID | None
        - _to_account_id: UUID | None
        - _status: TransactionStatus
        - _fee: Decimal
        - _description: str | None
        + with_id(id): TransactionBuilder
        + with_type(type): TransactionBuilder
        + with_amount(amount): TransactionBuilder
        + with_currency(currency): TransactionBuilder
        + from_account(id): TransactionBuilder
        + to_account(id): TransactionBuilder
        + with_status(status): TransactionBuilder
        + with_fee(fee): TransactionBuilder
        + with_description(desc): TransactionBuilder
        + build(): Transaction
        + reset(): TransactionBuilder
    }
    
    TransactionFactory ..> Transaction : creates
    TransactionBuilder ..> Transaction : builds
}

' ==================== SERVICE LAYER ====================

package "Service Layer" <<Rectangle>> {
    
    class BankingService {
        - _customer_repo: CustomerRepository
        - _account_repo: AccountRepository
        - _transaction_repo: TransactionRepository
        - _ledger_repo: LedgerEntryRepository
        - _fee_strategy: FeeStrategy
        - _risk_strategies: List[RiskStrategy]
        + create_customer(name, email): Customer
        + get_customer(id): Customer
        + create_account(customer_id, currency): Account
        + get_account(id): Account
        + deposit(account_id, amount, desc): Transaction
        + withdraw(account_id, amount, desc): Transaction
        + transfer(from_id, to_id, amount, desc): Transaction
        + list_transactions(account_id, limit, offset): List[Transaction]
        - _check_risk_rules(...): RiskCheckResult
    }
    
    BankingService --> FeeStrategy : uses
    BankingService --> RiskStrategy : uses
    BankingService ..> Customer : manages
    BankingService ..> Account : manages
    BankingService ..> Transaction : creates
    BankingService ..> LedgerEntry : creates
}

' ==================== FACADE PATTERN ====================

package "Application Layer (Facade Pattern)" <<Rectangle>> #PURPLE {
    
    class BankingFacade <<Facade>> {
        - _customer_repo: CustomerRepository
        - _account_repo: AccountRepository
        - _transaction_repo: TransactionRepository
        - _ledger_repo: LedgerEntryRepository
        - _fee_strategy: FeeStrategy
        - _risk_strategies: List[RiskStrategy]
        - _service: BankingService
        + create_customer(name, email): Customer
        + get_customer(id): Customer
        + create_account(customer_id, currency): Account
        + get_account(id): Account
        + get_customer_accounts(customer_id): List[Account]
        + deposit(account_id, amount, desc): Transaction
        + withdraw(account_id, amount, desc): Transaction
        + transfer(from_id, to_id, amount, desc): Transaction
        + list_transactions(account_id, limit, offset): List[Transaction]
        + get_transaction(id): Transaction | None
        - _get_fee_strategy(name): FeeStrategy
    }
    
    BankingFacade --> BankingService : delegates to
}

' ==================== REPOSITORY INTERFACES ====================

package "Repository Interfaces (Ports)" <<Rectangle>> {
    
    interface CustomerRepository <<Protocol>> {
        + save(customer): Customer
        + find_by_id(id): Customer | None
        + find_by_email(email): Customer | None
        + list_all(limit, offset): List[Customer]
        + delete(id): bool
    }
    
    interface AccountRepository <<Protocol>> {
        + save(account): Account
        + find_by_id(id): Account | None
        + find_by_customer_id(customer_id): List[Account]
        + list_all(limit, offset): List[Account]
        + delete(id): bool
    }
    
    interface TransactionRepository <<Protocol>> {
        + save(transaction): Transaction
        + find_by_id(id): Transaction | None
        + find_by_account_id(id, limit, offset): List[Transaction]
        + find_recent_by_account(id, since): List[Transaction]
        + list_all(limit, offset): List[Transaction]
    }
    
    interface LedgerEntryRepository <<Protocol>> {
        + save(entry): LedgerEntry
        + find_by_account_id(id, limit, offset): List[LedgerEntry]
        + find_by_transaction_id(id): List[LedgerEntry]
    }
}

' ==================== RELATIONSHIPS ====================

Customer "1" -- "*" Account : tiene >
Account "1" -- "*" LedgerEntry : registra >
Transaction "1" -- "*" LedgerEntry : genera >

BankingService --> CustomerRepository : usa
BankingService --> AccountRepository : usa
BankingService --> TransactionRepository : usa
BankingService --> LedgerEntryRepository : usa

note right of BankingFacade
  <b>Facade Pattern</b>
  Punto de entrada único
  para la capa de aplicación.
  Simplifica el acceso al
  subsistema complejo.
end note

note right of FeeStrategy
  <b>Strategy Pattern</b>
  Permite cambiar el algoritmo
  de cálculo de comisiones
  dinámicamente sin modificar
  el código cliente.
end note

note right of RiskStrategy
  <b>Strategy Pattern</b>
  Permite configurar múltiples
  reglas de riesgo/fraude que
  se evalúan antes de aprobar
  una transacción.
end note

note right of TransactionFactory
  <b>Factory Method</b>
  Encapsula la creación de
  diferentes tipos de
  transacciones con
  validaciones específicas.
end note

note right of TransactionBuilder
  <b>Builder Pattern</b>
  Construye transacciones
  complejas paso a paso con
  una interfaz fluida.
end note

@enduml
